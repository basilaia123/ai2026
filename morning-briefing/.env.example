# მხოლოდ საიდუმლოებები. ეს ფაილი დააკოპირე სახელით .env და შეავსე.
# ცარიელი მნიშვნელობა ნიშნავს, რომ ეს წყარო ბრიფინგში მიუწვდომელი იქნება.

# Gmail, მხოლოდ წაკითხვა. სრული მისამართი და App Password.
# ჩვეულებრივი პაროლი არ გამოდგება. შექმენი აქ: https://myaccount.google.com/apppasswords
IMAP_USERNAME=
IMAP_PASSWORD=

# CalDAV, მხოლოდ წაკითხვა. calendar.source თუ CalDAV-ზე გადართავ.
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# ICS ბმული. ხშირად საიდუმლო ტოკენს შეიცავს, ამიტომ აქ წერია.
ICS_URL=

# ბრიფინგის გაგზავნა იმავე Gmail-ით. ცარიელი USERNAME/PASSWORD/FROM
# იღებს IMAP-ის მნიშვნელობას. SMTP_TO შეავსე მხოლოდ მაშინ, თუ channel არის email.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Telegram. დილის გაგზავნაც და bot.py-ის long polling-იც ამ ორ ცვლადს იყენებს.
# ტოკენი BotFather-ისგანაა. chat id შენი პირადი ჩატია ბოტთან. კოდში არ იწერება.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LiteLLM თავად კითხულობს ამ სახელებს. რომელსაც არ იყენებ, ცარიელი დატოვე.
# მოდელის სახელი config.yaml-შია. Ollama-სთვის ფორმატია ollama_chat/<მოდელი>.
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_BASE=http://127.0.0.1:11434
