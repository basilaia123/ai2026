<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional. IIS already serves .txt/.xml by default; this only adds charset=utf-8 so the
     Georgian text in llms.txt / llms-full.txt renders correctly. If a web.config already exists
     in the make.ge web root, MERGE the <staticContent> block into it instead of overwriting.
     The <remove> lines prevent the "duplicate collection entry" 500 error. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml; charset=utf-8" />
    </staticContent>
  </system.webServer>
</configuration>
