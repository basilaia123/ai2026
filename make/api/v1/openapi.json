{
  "openapi": "3.1.0",
  "info": {
    "title": "Make.ge No-Code & Autonomous AI Agents API",
    "description": "Automated discovery API for Make.com, n8n, Model Context Protocol (MCP), and local LLMs workflows in Georgia.",
    "version": "1.0.0",
    "contact": {
      "name": "Giorgi Basilaia",
      "url": "https://basilaia.com"
    }
  },
  "servers": [
    {
      "url": "https://make.ge/api/v1",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/services": {
      "get": {
        "summary": "List make.ge core services and educational tracks",
        "responses": {
          "200": {
            "description": "Successful retrieval"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Service health check",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "pass"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}